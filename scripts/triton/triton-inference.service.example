[Unit]
Description=Triton Inference Server for GTV2 (Docker)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=TRITON_IMAGE=projections-gtv2-triton:24.12-py3
Environment=TRITON_CONTAINER_NAME=gtv2-triton
Environment=TRITON_MODEL_REPO=/home/daniel/projections-data/triton_models
Environment=TRITON_PROJECT_ROOT=/home/daniel/projects/projections-v2
Environment=TRITON_DATA_ROOT=/home/daniel/projections-data
Environment=TRITON_HTTP_PORT=18000
Environment=TRITON_GRPC_PORT=18001
Environment=TRITON_METRICS_PORT=18002
ExecStart=/home/daniel/projects/projections-v2/scripts/triton/run_triton_gtv2.sh start
ExecStop=/home/daniel/projects/projections-v2/scripts/triton/run_triton_gtv2.sh stop

[Install]
WantedBy=default.target
