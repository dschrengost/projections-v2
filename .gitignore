# -------------------------
# Python / caches
# -------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
htmlcov/

# -------------------------
# Environments
# -------------------------
.venv/
.venv-user/
.uv-cache/
.env
.env.*
pip-wheel-metadata/

# -------------------------
# Editors / OS
# -------------------------
.DS_Store
.idea/
.vscode/
.serena/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Logs / profiles / crashes
# -------------------------
*.log
nohup.out
hs_err_pid*.log
replay_pid*.log
scalene-profile.html
profile*.json
*.prof

# -------------------------
# Local scratch (ephemeral work)
# -------------------------
scratch/
tmp/
local/

# -------------------------
# Data files (ignored by default)
# -------------------------
*.csv
*.parquet

# Allow test fixtures
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet

# -------------------------
# Runtime artifacts (should live outside repo)
# -------------------------
mlruns/
artifacts/
runs/
data/

# Keep .gitkeep for empty directory structure
!data/**/.gitkeep
!artifacts/**/.gitkeep
!runs/**/.gitkeep

# -------------------------
# Command-paste accidents
# Prevent files created by accidental terminal paste
# -------------------------
udo *
sudo *