# -------------------------
# Python / caches
# -------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
htmlcov/

# -------------------------
# Environments
# -------------------------
.venv/
.venv-user/
.uv-cache/
.env
.env.*
pip-wheel-metadata/

# -------------------------
# Editors / OS
# -------------------------
.DS_Store
.idea/
.vscode/
.serena/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Logs / profiles / crashes
# -------------------------
*.log
nohup.out
hs_err_pid*.log
replay_pid*.log
scalene-profile.html
profile*.json
*.prof

# -------------------------
# Local scratch (ephemeral work)
# -------------------------
scratch/
tmp/
local/
reports/sim_audit/
reports/parity_audit/
reports/gtv2_*/
handoffs/

# -------------------------
# Data files (ignored by default)
# -------------------------
*.csv
*.parquet

# Allow test fixtures
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet

# -------------------------
# Runtime artifacts (should live outside repo)
# -------------------------
mlruns/
artifacts/
runs/
data/

# Keep .gitkeep for empty directory structure
!data/**/.gitkeep
!artifacts/**/.gitkeep
!runs/**/.gitkeep

# Keep code package files under projections/artifacts tracked.
!projections/artifacts/
!projections/artifacts/__init__.py
!projections/artifacts/unified_projections.py

# -------------------------
# Command-paste accidents
# Prevent files created by accidental terminal paste at repo root
# -------------------------
/udo *
/sudo *
/systemctl *

# -------------------------
# GTv2 experiment artifacts
# -------------------------
/gtv2_*.json
